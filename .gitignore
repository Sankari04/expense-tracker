# ===================================================
# Expense Tracker - Root .gitignore
# ===================================================

# Node / Frontend
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local
.npm/

# Maven / Java
backend/target/
backend/apache-maven-*/
backend/*.zip
*.class
*.jar
*.war

# IDE & Editors
.idea/
.vscode/
*.iml
*.iws
*.ipr
.classpath
.project
.settings/

# Logs & Temporary files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.system_generated/

# OS generated files
.DS_Store
Thumbs.db
